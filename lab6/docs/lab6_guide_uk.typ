```cpp
    // ************************ begin solution ************************
    const Eigen::Isometry3d est = tf2TransformToIsometry(est_relative_pose);
    const Eigen::Isometry3d gt = tf2TransformToIsometry(gt_relative_pose);

    // Обертання: хордальна відстань (Eigen::Matrix::norm() — це норма Фробеніуса)
    const double rot_err = (gt.rotation() - est.rotation()).norm();
    const double rot_err_deg =
        2.0 * std::asin(std::min(1.0, rot_err / (2.0 * std::sqrt(2.0)))) * 180.0 / M_PI;

    // Трансляція: для 2D-2D порівнюємо лише напрямки (одиничні вектори)
    Eigen::Vector3d t_gt = gt.translation();
    Eigen::Vector3d t_est = est.translation();
    const double gt_norm = t_gt.norm();
    const bool normalize = pose_estimator_ < 3;
    if (normalize) {
      if (gt_norm < 1e-6 || t_est.norm() < 1e-6) {
        RCLCPP_WARN(get_logger(), "Translation too small to normalize, skipping frame");
        return;
      }
      t_gt.normalize();
      t_est.normalize();
    }
    const double trans_err = (t_gt - t_est).norm();

    RCLCPP_INFO(get_logger(), "RPE: trans %.4f | rot %.5f (%.3f deg)",
                trans_err, rot_err, rot_err_deg);
    if (rpe_log_.is_open()) {
      rpe_log_ << std::fixed << std::setprecision(6) << current_stamp_ << ","
               << trans_err << "," << rot_err << "," << rot_err_deg << ","
               << gt_norm << "\n";
      rpe_log_.flush();
    }
    // ************************ end solution *****************************
```

#vars(
  [`est`, `gt`], [`Eigen::Isometry3d` — оцінена та GT відносні пози ($4 times 4$ жорстке перетворення)],
  [`rot_err`], [хордальна похибка обертання $norm(R_"ref" - R_"est")_F$],
  [`rot_err_deg`], [та сама похибка, переведена в кут $theta$ у градусах],
  [`t_gt`, `t_est`], [трансляції $bold(t)_"ref"$, $bold(t)_"est"$ (після нормування — одиничні)],
  [`gt_norm`], [довжина справжнього зсуву між кадрами в метрах (до нормування)],
  [`normalize`], [чи порівнювати лише напрями (для 2D–2D методів — так)],
  [`trans_err`], [похибка трансляції $"RPE"^"tran"$],
)

#note[Колонка `gt_trans_norm` (довжина GT-трансляції між кадрами) корисна для аналізу: великі похибки напрямку майже завжди припадають на кадри, де дрон ледь зрушив — це виродження $bold(t) approx 0$ з розділу 3.2, а не баг.]

